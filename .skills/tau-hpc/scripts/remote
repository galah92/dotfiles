#!/usr/bin/env python3
"""Run a command on a TAU HPC login host with the required setup."""

from __future__ import annotations

import argparse
import base64
import os
from pathlib import Path, PurePosixPath
import shlex
import shutil
import subprocess
import sys


def load_saved_env() -> dict[str, str]:
    home = os.environ.get("HOME")
    if not home:
        return {}
    path = Path(home) / ".config" / "tau-hpc" / "env"
    if not path.is_file():
        return {}
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        k = k.removeprefix("export ").strip()
        values[k] = shlex.split(v)[0] if v.strip() else ""
    return values


TARGETS = {
    "power": {
        "host": "slurmlogin.tau.ac.il",
        "base": "/scratch300/galaharoni",
        "setup": 'export HOME=/scratch300/galaharoni; export PATH="$HOME/.local/bin:$PATH"',
        "ssh_options": ("-o", "StrictHostKeyChecking=no"),
        "tcsh": False,
    },
    "cs": {
        "host": "slurm-client.cs.tau.ac.il",
        "base": "/specific/scratches/scratch/galaharoni",
        "setup": "",
        "ssh_options": (
            "-o",
            "StrictHostKeyChecking=no",
            "-o",
            "UserKnownHostsFile=/dev/null",
        ),
        "tcsh": True,
    },
    "tml": {
        "host": "slurm-client.cs.tau.ac.il",
        "base": "/home/sharifm/teaching/tml-0368-4075/galaharoni",
        "setup": "",
        "ssh_options": (
            "-o",
            "StrictHostKeyChecking=no",
            "-o",
            "UserKnownHostsFile=/dev/null",
        ),
        "tcsh": True,
    },
    "apdl": {
        "host": "slurm-client.cs.tau.ac.il",
        "base": "/home/yandex/APDL2526a/galaharoni",
        "setup": "",
        "ssh_options": (
            "-o",
            "StrictHostKeyChecking=no",
            "-o",
            "UserKnownHostsFile=/dev/null",
        ),
        "tcsh": True,
    },
    "mass": {
        "host": "rack-mad-01.cs.tau.ac.il",
        "base": None,
        "setup": "",
        "ssh_options": (
            "-o",
            "StrictHostKeyChecking=no",
            "-o",
            "UserKnownHostsFile=/dev/null",
        ),
        "tcsh": True,
    },
}


def parse_args(argv: list[str]) -> argparse.Namespace:
    if not argv or argv[0] not in (*TARGETS, "-h", "--help"):
        argv = ["power", *argv]
    parser = argparse.ArgumentParser(
        prog="tau",
        usage="tau [power|cs|tml|apdl|mass] ([-C DIR] [-c CMD | CMD ...] | put LOCAL REMOTE | get REMOTE LOCAL)",
        description="Run a command or transfer files on a TAU HPC host.",
        epilog=(
            "Power is the default target. Use -c for shell syntax (pipes, redirects, multiline). "
            "For put/get, relative REMOTE paths resolve under the target's default working directory."
        ),
    )
    targets = parser.add_subparsers(dest="target", required=True)
    for name in TARGETS:
        target = targets.add_parser(name)
        target.add_argument(
            "-C",
            "--directory",
            metavar="DIR",
            help="remote working directory (relative to the target's default directory)",
        )
        target.add_argument(
            "-c",
            "--shell-command",
            metavar="COMMAND",
            help="command interpreted by remote bash",
        )
        target.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    if args.command[:1] == ["--"]:
        args.command = args.command[1:]
    if args.shell_command is not None and args.command:
        parser.error("do not combine -c with a direct command")
    if args.shell_command is None and not args.command:
        parser.error("a command is required")
    return args


def working_directory(target: dict[str, object], requested: str | None) -> str:
    base = target["base"]
    if requested is None:
        return str(base) if base else "$HOME"
    path = PurePosixPath(requested)
    if path.is_absolute() or not base:
        return str(path)
    return str(PurePosixPath(str(base), path))


def build_remote_command(args: argparse.Namespace) -> str:
    target = TARGETS[args.target]
    directory = working_directory(target, args.directory)
    if directory == "$HOME":
        change_directory = 'cd -- "$HOME"'
    else:
        change_directory = f"cd -- {shlex.quote(directory)}"

    command = args.shell_command
    if command is None:
        command = "exec " + shlex.join(args.command)

    statements = [str(target["setup"]), change_directory, command]
    body = "; ".join(statement for statement in statements if statement)
    if target.get("tcsh"):
        b64 = base64.b64encode(body.encode("utf-8")).decode("ascii")
        return f"""/bin/bash -lc 'eval "$(echo {b64} | base64 -d)"'"""
    return f"/bin/bash -lc {shlex.quote(body)}"


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    saved = load_saved_env() if not os.environ.get("TAU_PASSWORD") else {}
    password = os.environ.get("TAU_PASSWORD") or saved.get("TAU_PASSWORD")
    username = os.environ.get("TAU_USERNAME") or saved.get("TAU_USERNAME") or "galaharoni"
    if not password:
        print("tau: TAU_PASSWORD is not set", file=sys.stderr)
        return 2
    if not username:
        print("tau: TAU_USERNAME is empty", file=sys.stderr)
        return 2

    target = TARGETS[args.target]
    environment = os.environ.copy()
    environment["SSHPASS"] = password

    if args.shell_command is None and len(args.command) == 3 and args.command[0] in {"put", "get"}:
        mode, src, dst = args.command
        if mode == "put":
            remote_path = working_directory(target, dst)
            if dst.endswith("/") and not remote_path.endswith("/"):
                remote_path += "/"
            pair = [src, f'{username}@{target["host"]}:{remote_path}']
        else:
            remote_path = working_directory(target, src)
            if src.endswith("/") and not remote_path.endswith("/"):
                remote_path += "/"
            pair = [f'{username}@{target["host"]}:{remote_path}', dst]
        if shutil.which("rsync"):
            ssh_cmd = shlex.join(["ssh", *target["ssh_options"]])
            command = [
                "sshpass",
                "-e",
                "rsync",
                "-az",
                "--partial",
                "--exclude=.venv",
                "--exclude=__pycache__",
                "-e",
                ssh_cmd,
                *pair,
            ]
        else:
            command = ["sshpass", "-e", "scp", "-r", "-C", *target["ssh_options"], *pair]
        return subprocess.run(command, env=environment, check=False).returncode

    command = [
        "sshpass",
        "-e",
        "ssh",
        *target["ssh_options"],
        f'{username}@{target["host"]}',
        build_remote_command(args),
    ]
    return subprocess.run(command, env=environment, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
